{
  "principals": [
    {
      "arn": "arn:aws:iam::111122223333:role/dev",
      "policies": [
        {
          "name": "dev-deploys-lambdas",
          "document": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": ["lambda:CreateFunction", "lambda:InvokeFunction"],
                "Resource": "*"
              },
              {
                "Effect": "Allow",
                "Action": "iam:PassRole",
                "Resource": "arn:aws:iam::111122223333:role/etl-exec",
                "Condition": {
                  "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "arn": "arn:aws:iam::111122223333:role/etl-exec",
      "trust_policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": { "Service": "lambda.amazonaws.com" },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "policies": [
        {
          "name": "etl-reads-prod",
          "document": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": "s3:GetObject",
                "Resource": "arn:aws:s3:::prod-data/*"
              }
            ]
          }
        }
      ]
    },
    {
      "arn": "arn:aws:iam::111122223333:role/data-team",
      "policies": [
        {
          "name": "data-team-access",
          "document": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Effect": "Allow",
                "Action": ["s3:GetObject", "s3:ListBucket"],
                "Resource": ["arn:aws:s3:::prod-data", "arn:aws:s3:::prod-data/*"]
              }
            ]
          }
        }
      ]
    }
  ]
}
